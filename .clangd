# Clangd 配置（STM32F1，ARM-GCC 工具链）
# 目标：
# 1) 使用 CMake 生成的 compile_commands.json，保持与实际编译参数一致。
# 2) 让 clangd 查询 ARM GCC 驱动，自动获取系统/newlib 头文件路径（解决 string.h 不可见）。
# 3) 补充常用 MCU 编译参数和头文件搜索路径，方便独立文件解析。

# 说明：
# - `.clangd` 配置文件本身不能指定 compile_commands 目录，也不能配置 query-driver。
# - 这两项需要通过 clangd 启动参数传入（VS Code: `.vscode/settings.json` 的 `clangd.arguments`）。
#   否则 clangd 可能回退到默认 x86_64 目标解析，从而出现：
#   - "Unsupported option '-mcpu=' for target x86_64-pc-windows-msvc"
#   - 系统头 `<string.h>` / C++ 标准库头 `<type_traits>` 找不到

# 当 compile_commands 缺少条目或独立文件解析时附加的编译参数
CompileFlags:
  Add:
    # 指定交叉目标三元组，避免默认走 x86_64-msvc 导致 -mcpu 不被识别
    - -target
    - arm-none-eabi
    # 目标 MCU 架构
    - -mcpu=cortex-m3
    - -mthumb
    # 常用的工程/公共头文件搜索路径
    - -ICore/Inc
    - -IDrivers/CMSIS/Include
    - -IDrivers/CMSIS/Device/ST/STM32F1xx/Include
    - -IDrivers/STM32F1xx_HAL_Driver/Inc
    # C++ 标准库头文件（如 type_traits）路径
    # 说明：你的工具链实际是 Arm GNU Toolchain 14.3.Rel1，头文件版本目录为 14.3.1
    #      （可用 `arm-none-eabi-g++ -v -E -x c++ - < nul` 查看）。
    - -isystem
    - "C:/INCLUD~1/Tools/EMBEDD~1/ARM-NO~1/142BCE~1.3RE/arm-none-eabi/include/c++/14.3.1"
    - -isystem
    - "C:/INCLUD~1/Tools/EMBEDD~1/ARM-NO~1/142BCE~1.3RE/arm-none-eabi/include/c++/14.3.1/arm-none-eabi"
    - -isystem
    - "C:/INCLUD~1/Tools/EMBEDD~1/ARM-NO~1/142BCE~1.3RE/arm-none-eabi/include/c++/14.3.1/backward"
    - -isystem
    - "C:/INCLUD~1/Tools/EMBEDD~1/ARM-NO~1/142BCE~1.3RE/lib/gcc/arm-none-eabi/14.3.1/include"
    - -isystem
    - "C:/INCLUD~1/Tools/EMBEDD~1/ARM-NO~1/142BCE~1.3RE/lib/gcc/arm-none-eabi/14.3.1/include-fixed"
    - -isystem
    - "C:/INCLUD~1/Tools/EMBEDD~1/ARM-NO~1/142BCE~1.3RE/arm-none-eabi/include"

---
# ETL 的头文件大量使用 .h 扩展名，但内容是 C++（有 namespace/template）。
# 当你“直接打开”这些 .h 时，clangd 可能按 C 解析，从而报 "unknown type name 'namespace'"。
# 这里对 ETL include 目录下的 .h 强制按 C++ 解析。
If:
  # 同时匹配 Windows 路径分隔符 '\\' 与 Unix '/'
  # 并容忍路径大小写差异（Windows 文件系统通常大小写不敏感，但 clangd 的正则是区分大小写的）
  PathMatch: ".*[\\\\/][Ll]ib[\\\\/][Ee]tl[\\\\/][Ii]nclude[\\\\/].*\\.(h|hpp)$"
CompileFlags:
  # 说明：clangd 有时会给头文件“借用”某个 .c 的编译参数（例如 -std=gnu11），
  #      会导致 C++ 关键字/namespace 被当成 C 来解析，从而报 unknown type name 'namespace'。
  #      这里强制把 ETL 的 .h 当 C++ 解析，并移除常见的 C 标准选项。
  Remove:
    - "-std=gnu11"
    - "-std=c11"
    - "-std=gnu99"
    - "-std=c99"
    # 有时也会显式携带语言选项（两段式：-x c）
    - "-x"
    - "c"
  Add:
    - "-xc++"
    - "-std=gnu++17"

# 诊断配置（保持精简，避免屏蔽关键信息）
Diagnostics:
  Suppress:
    - "clang(pp_hash_error)"  # 头文件暂缺时避免噪声
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    Add:
      - readability-*
      - modernize-*
    Remove:
      - modernize-use-trailing-return-type
